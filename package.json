{
  "name": "nusa-custom",
  "version": "1.0.0",
  "description": "Notch overlay for Windows",
  "author": "Shivansh Gupta",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "http-server ui -p 5173 -c-1",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.shivansh.nusacustom",
    "productName": "NusaCustom",
    "files": ["main.js", "preload.js", "media.js", "ui/**/*"],
    "extraResources": [{ "from": "scripts", "to": "scripts" }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true }
  }
}